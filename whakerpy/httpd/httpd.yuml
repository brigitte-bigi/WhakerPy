// Inheritance is written [Superclass]^[Subclass].
//
// Copy/paste the following at:
// https://yuml.me/diagram/scruffy/class/draw
// Or try with: https://github.com/jaime-olivares/yuml-diagram

// -------------------
// Class descriptions
// -------------------

// The HTTP status of a response.
[HTTPDStatus|+code:int|get();set();check();to_html()]
[HTTPDValueError]

// The threading HTTP server: holds the pages and the security policy.
[BaseHTTPDServer|#pages:dict;#default:str;#policy:HTTPDPolicy|configure();policy_check();default();page_bakery()]

// Base class to bake an HTML response page.
// Intent to be used as base class for any html page.
[BaseResponseRecipe|+name:str;+status:HTTPDStatus;+tree:HTMLTree|bake(events);create();get_data();reset_data();-process_events(events)]

// The request handler: turns a GET/POST/HEAD request into a response.
[HTTPDHandler|get_default_page();do_HEAD();do_GET();do_POST();log_request()]

// Stateless helpers shared by the handler and the WSGI application.
[HTTPDHandlerUtils|get_path();get_page_name();static_content();process_post();parse_query_string();bakery();has_to_return_data();build_default_headers()]

// The security policy: blacklist and signed URL verification.
[HTTPDPolicy|configure();check();finalize_html()]
[Blacklist|-blacklist:set|configure();match();load()]
[SignedURL|-secret:bytes|configure();load();match_protect();sign();verify()]

// Static file access control, on Unix filesystems.
[UnixPermissions|+owner;+group;+others|is_valid_role()]
[FileAccessChecker|-filename:str|get_filename();read_allowed()]

// -------------------
// Class relations
// -------------------

[http.server.ThreadingHTTPServer {bg:purple}]^[BaseHTTPDServer]
[http.server.BaseHTTPRequestHandler {bg:purple}]^[HTTPDHandler]

[BaseHTTPDServer]-1>[BaseResponseRecipe]
[BaseHTTPDServer]-1>[HTTPDPolicy]

[BaseResponseRecipe]-1>[HTMLTree {bg:purple}]
[BaseResponseRecipe]-1>[HTTPDStatus]

[HTTPDHandler]->[BaseHTTPDServer]
[HTTPDHandler]-1>[HTTPDHandlerUtils]

[HTTPDHandlerUtils]-1>[HTTPDStatus]
[HTTPDHandlerUtils]->[FileAccessChecker]
[FileAccessChecker]-1>[UnixPermissions]

[HTTPDPolicy]-1>[Blacklist]
[HTTPDPolicy]-1>[SignedURL]

[HTTPDStatus]->[HTTPDValueError]

[WSGIApplication {bg:purple}]-1>[HTTPDHandlerUtils]
[WSGIApplication {bg:purple}]-1>[HTTPDPolicy]
