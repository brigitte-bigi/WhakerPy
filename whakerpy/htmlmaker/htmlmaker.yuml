//
// Inheritance is written [Superclass]^[Subclass].
//
// Copy/paste the following at:
// https://yuml.me/diagram/scruffy/class/draw
// Or try with: https://github.com/jaime-olivares/yuml-diagram

// -------------------
// Class descriptions
// -------------------

// The root class of any node of an HTML tree.
[BaseNode|+identifier:str;+parent:BaseNode|is_leaf();is_root();get_parent();set_parent();has_child(id);serialize()]

// Leaf nodes without children nor attributes.
[Doctype]
[HTMLComment]

// A node with attributes but no children.
[BaseTagNode|+tag:str;-attributes:dict|check_attribute(k);set_attribute(k,v);add_attribute(k,v);get_attribute_value(k);has_attribute(k);remove_attribute(k);nb_attributes();serialize()]
[EmptyNode]
[HTMLInputText]
[HTMLImage]
[HTMLHr]
[HTMLBr]

// A node with attributes and children.
[TagNode|-children:list;-value:str|get_child(id);children_size();has_child(id);append_child(node);insert_child(pos,node);remove_child(id);pop_child(pos);clear_children();set_value(v);serialize()]
[HTMLNode]
[HTMLRadioBox]
[HTMLButtonNode]
[HTMLHeadNode|title();meta();link();script();css()]
[HTMLHeaderNode]
[HTMLNavNode]
[HTMLMainNode]
[HTMLFooterNode]
[HTMLScriptNode]

// An HTML page is a tree of nodes.
// The root has 2 children: the head and the body.
[HTMLTree|-id:str;+head:HTMLHeadNode;+body_header:HTMLNode;+body_nav:HTMLNode;+body_main:HTMLNode;+body_footer:HTMLNode;+body_script:HTMLNode|element();button();image();comment();serialize();serialize_to_file()]
[HTMLTreeError]

// -------------------
// Class relations
// -------------------

[BaseNode]^[Doctype]
[BaseNode]^[HTMLComment]
[BaseNode]^[BaseTagNode]
[BaseNode]^[HTMLTree]

[BaseTagNode]^[EmptyNode]
[BaseTagNode]^[TagNode]

[EmptyNode]^[HTMLInputText]
[EmptyNode]^[HTMLImage]
[EmptyNode]^[HTMLHr]
[EmptyNode]^[HTMLBr]

[TagNode]^[HTMLNode]

[HTMLNode]^[HTMLRadioBox]
[HTMLNode]^[HTMLButtonNode]
[HTMLNode]^[HTMLHeadNode]
[HTMLNode]^[HTMLHeaderNode]
[HTMLNode]^[HTMLNavNode]
[HTMLNode]^[HTMLMainNode]
[HTMLNode]^[HTMLFooterNode]
[HTMLNode]^[HTMLScriptNode]

[HTMLTree]^[HTMLTreeError]

// A tag node aggregates its children nodes.
[TagNode]<>-*>[BaseNode]

[HTMLTree]-1>[Doctype]
[HTMLTree]-1>[HTMLNode]
